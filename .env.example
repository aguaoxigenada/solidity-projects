# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
#   cp .env.example .env
#
# Load it into your shell before running forge:
#   source .env
# (or use a tool like direnv). foundry.toml reads these via ${VAR} in [rpc_endpoints].

# --- Sepolia testnet ---------------------------------------------------------
# A Sepolia RPC endpoint. Free options: dRPC, Alchemy, Infura, or a public node.
# Public (no signup):  https://sepolia.drpc.org  or  https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# The private key that will PAY for and SIGN the deployment.
# Use a THROWAWAY key funded only with faucet (test) ETH — never a key with real funds.
# Get test ETH from a faucet, e.g. https://sepoliafaucet.com or Alchemy's faucet.
# Must start with 0x.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY_HERE

# --- Optional: source verification on Etherscan ------------------------------
# Lets `forge script ... --verify` publish your source so the contract is readable
# on sepolia.etherscan.io. Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE
